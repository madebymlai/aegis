# Local agent/MCP config — may contain secrets (API keys, tokens). Never commit.
opencode.json
opencode.jsonc
.mcp.json
.env
.env.*
!.env.example

# Execution Bundle wheels are regenerable from a Lock (ADR-0001): ignore the
# artifacts but keep the output dir tracked via .gitkeep.
bundles/*
!bundles/.gitkeep
vbt.toml
