# Local agent/MCP config — may contain secrets (API keys, tokens). Never commit.
opencode.json
opencode.jsonc
.mcp.json
.env
.env.*
!.env.example

# Execution Bundle wheels are regenerable from a Lock (ADR-0001): ignore the
# artifacts but keep the output dir tracked via .gitkeep.
bundles/*
!bundles/.gitkeep
vbt.toml

# Sandcastle agent worktrees: nested full-repo checkouts (100G+) holding run
# data and their own nested .sandcastle/. Kept local-only and excluded from
# indexing — codebase-memory-mcp walks .gitignore but not .git/info/exclude,
# so listing it here is what actually keeps the indexer out (avoids OOM).
.sandcastle/

# Virtualenvs (regenerable from lockfiles). The root .venv and aegis-rd's
# sandcastle venv aren't covered by the per-package .gitignores.
.venv/
.venv-sandcastle/
